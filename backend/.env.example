# backend/.env 로 복사해서 사용하세요.

# --- Database ---
DATABASE_URL=mysql+pymysql://devshiplog:devshiplog@localhost:3306/devshiplog

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# USD / 1M tokens. 모델을 바꾸면 단가도 함께 수정해야 사용량 통계가 맞습니다.
LLM_INPUT_COST_PER_1M=0.15
LLM_OUTPUT_COST_PER_1M=0.60

# --- Security ---
# 프로덕션에서는 32자 이상의 임의 문자열이어야 하며, 기본값이면 서버가 기동되지 않습니다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (JSON 배열) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Crawler ---
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_BYTES=5242880
# 사설/루프백 대역 크롤링 허용 (SSRF). 프로덕션에서는 반드시 false 로 두세요.
CRAWLER_ALLOW_PRIVATE_NETWORK=false

# --- 사용량 제한 ---
# 사용자당 월간 LLM Job 수. 0 이면 무제한.
MONTHLY_JOB_QUOTA=100

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- 관측 -------------------------------------------------------------
# 배포에서는 true 로. JSON 이라야 요청 ID 로 로그를 모아 볼 수 있다.
LOG_JSON=false
# 로그와 오류 화면에 실린다. 배포 직후 생긴 오류인지 구분하려면 필요하다.
APP_VERSION=0.1.0
# 비워 두면 프로세스 안에만 오류를 모은다 — 재시작하면 사라진다.
# 실제 서비스로 열 때는 채우는 편이 좋다.
SENTRY_DSN=""

# --- 백업 -------------------------------------------------------------
# 백업 보관 위치와 보존 기간(일). scripts/backup.py 가 읽는다.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- 공개 페이지 캐시 무효화 ---
# 발행/댓글 시 Next 서버에 캐시를 깨라고 알린다. 비워두면 시간 기반 재검증만 동작한다.
FRONTEND_ORIGIN=http://localhost:3000
REVALIDATE_SECRET=change-me

# --- 업로드 저장소 (MinIO / S3) ---
# docker compose 의 MinIO 를 기본으로 쓴다. AWS S3 와 API 가 같아서 개발과 운영이
# 같은 코드로 돌고, AWS 로 옮길 때는 STORAGE_S3_ENDPOINT 만 비우면 된다.
# local 은 오브젝트 저장소 없이 잠깐 돌려볼 때만 쓰세요 (다중 인스턴스에서 깨집니다).
STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=devshiplog
STORAGE_S3_ACCESS_KEY=devshiplog
STORAGE_S3_SECRET_KEY=devshiplog1234
STORAGE_S3_REGION=us-east-1
# S3 API 주소. 컨테이너 안에서 돌리면 http://minio:9000 으로 바꾸세요.
STORAGE_S3_ENDPOINT=http://localhost:9000
# 브라우저가 이미지를 받아갈 주소. 이 값이 글 본문에 그대로 박히므로
# 배포 전에 반드시 실제 도메인(또는 CDN)으로 바꿔야 합니다.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/devshiplog
MAX_UPLOAD_BYTES=5242880

# --- 메일 ---
# 비우면 발송하지 않고 로그만 남긴다 (개발용).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@devshiplog.com
PASSWORD_RESET_TTL_MINUTES=30
