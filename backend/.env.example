# backend/.env 로 복사해서 사용하세요.

# --- Database ---
DATABASE_URL=mysql+pymysql://devshiplog:devshiplog@localhost:3306/devshiplog

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# USD / 1M tokens. 모델을 바꾸면 단가도 함께 수정해야 사용량 통계가 맞습니다.
LLM_INPUT_COST_PER_1M=0.15
LLM_OUTPUT_COST_PER_1M=0.60

# --- Security ---
# 프로덕션에서는 32자 이상의 임의 문자열이어야 하며, 기본값이면 서버가 기동되지 않습니다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (JSON 배열) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Crawler ---
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_BYTES=5242880
# 사설/루프백 대역 크롤링 허용 (SSRF). 프로덕션에서는 반드시 false 로 두세요.
CRAWLER_ALLOW_PRIVATE_NETWORK=false

# --- 사용량 제한 ---
# 사용자당 월간 LLM Job 수. 0 이면 무제한.
MONTHLY_JOB_QUOTA=100

# --- App ---
ENVIRONMENT=development
DEBUG=true
