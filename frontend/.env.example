# frontend/.env.local 로 복사해서 사용하세요.

# 백엔드 API 주소 (브라우저와 서버 양쪽에서 사용)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# 생성 예: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# 공개 URL (메타데이터 canonical·OG·sitemap 에 쓰인다)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 백엔드가 캐시 무효화를 요청할 때 쓰는 공유 시크릿 (backend/.env 와 동일해야 함)
REVALIDATE_SECRET=change-me

# 캐시 무효화 통지를 받는 Redis (backend 와 같은 인스턴스).
# 설정하면 Next 인스턴스마다 구독해서, 몇 대를 띄우든 전부 캐시가 갱신된다.
# 비우면 백엔드의 HTTP 통지 한 곳만 갱신된다 (단일 인스턴스용).
REDIS_URL=redis://localhost:6379/0
