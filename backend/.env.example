# backend/.env 로 복사해서 사용하세요.

# --- Database ---
DATABASE_URL=mysql+pymysql://devshiplog:devshiplog@localhost:3306/devshiplog

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# USD / 1M tokens. 모델을 바꾸면 단가도 함께 수정해야 사용량 통계가 맞습니다.
LLM_INPUT_COST_PER_1M=0.15
LLM_OUTPUT_COST_PER_1M=0.60

# --- Security ---
# 프로덕션에서는 32자 이상의 임의 문자열이어야 하며, 기본값이면 서버가 기동되지 않습니다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (JSON 배열) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Crawler ---
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_BYTES=5242880
# 사설/루프백 대역 크롤링 허용 (SSRF). 프로덕션에서는 반드시 false 로 두세요.
CRAWLER_ALLOW_PRIVATE_NETWORK=false

# --- 사용량 제한 ---
# 사용자당 월간 LLM Job 수. 0 이면 무제한.
MONTHLY_JOB_QUOTA=100

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- 공개 페이지 캐시 무효화 ---
# 발행/댓글 시 Next 서버에 캐시를 깨라고 알린다. 비워두면 시간 기반 재검증만 동작한다.
FRONTEND_ORIGIN=http://localhost:3000
REVALIDATE_SECRET=change-me

# --- 업로드 저장소 ---
# local 은 개발·단일 인스턴스 전용이다. 서버를 2대 이상 띄우면 A 에 올린 파일을
# B 가 못 찾고, 컨테이너를 재배포하면 사라진다. 프로덕션에서는 s3 여야 한다.
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=5242880
# STORAGE_BACKEND=s3 일 때만 필요
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-northeast-2
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# MinIO·R2 등 S3 호환 저장소를 쓸 때만
STORAGE_S3_ENDPOINT=
# CDN 주소. 비우면 버킷 기본 주소를 쓴다.
STORAGE_PUBLIC_BASE_URL=

# --- 메일 ---
# 비우면 발송하지 않고 로그만 남긴다 (개발용).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@devshiplog.com
PASSWORD_RESET_TTL_MINUTES=30
